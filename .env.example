# Copy to .env and fill real values. NEVER commit .env.

# Supabase (MVP — used by frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER define VITE_SUPABASE_SERVICE_ROLE_KEY here or anywhere client-side.

# --- Dormant backend (future learning phase, DEC-005). Not used by MVP. ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/campusconnect
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_EXPIRY=24h
REDIS_URL=redis://localhost:6379
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=CampusConnect <noreply@example.com>